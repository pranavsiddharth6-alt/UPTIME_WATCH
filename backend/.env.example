UPTIMEWATCH_ENV=development
# Exact browser origin. Set the stable public Vercel HTTPS origin in Render.
UPTIMEWATCH_FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=uptimewatch
# Optional bearer token for non-browser CLI clients. Keep it server-side.
ADMIN_API_TOKEN=
