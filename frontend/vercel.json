{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://uptime-watch-q67r.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://uptime-watch-q67r.onrender.com/health"
    }
  ]
}
